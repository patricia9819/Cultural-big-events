{
  "name": "taichung-fiber-biennale-promo",
  "version": "1.0.0",
  "description": "2026 臺中纖維藝術雙年展 30 秒宣傳動畫（Remotion）",
  "scripts": {
    "music": "python3 scripts/music.py public/music.wav",
    "studio": "remotion studio src/index.ts",
