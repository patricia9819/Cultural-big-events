    "render:reels": "remotion render src/index.ts PromoVertical out/reels.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=256k"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.1.0",
    "@fontsource/noto-serif-tc": "^5.1.0",
    "@remotion/cli": "^4.0.242",
    "@remotion/renderer": "^4.0.242",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242"
  },
  "private": true
}
